# Copy to .env (local) or .env.prod (docker-compose.prod.yml).

settings_module=config.settings.local

DATABASE_URL=postgres://cg_crm@localhost:5432/cg_crm
DB_PASSWORD=

# Prod on AWS RDS: postgres://<user>@<instance>.<id>.<region>.rds.amazonaws.com:5432/<db>
# DB_SSLMODE defaults to verify-full in prod.

# Prod only (settings_module=config.settings.prod)
SECRET_KEY=
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
GUNICORN_WORKERS=3
